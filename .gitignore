# Unity generated directories
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset meta data for files outside the Assets folder
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/Plugins/Editor/JetBrains*

# Auto-generated solution and project files
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Visual Studio / Rider / VS Code
.vs/
.vscode/
.idea/
ExportedObj/
.consulo/

# Unity3D generated crash report
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties

# Packed addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# OS files
.DS_Store
Thumbs.db

# Release artifacts and keystores — never committed
Build/
*.keystore
*.jks

# Dropped by the test framework during play-mode runs
/[Aa]ssets/Resources/PerformanceTestRun*

# IL2CPP scratch tree, rewritten by every Android build
.utmp/

# Wrangler local cache, holds the resolved account id
.wrangler/
